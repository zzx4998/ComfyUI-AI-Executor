{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "write": "deny",
    "patch": "deny",
    "bash": {
      "*": "deny",
      "curl *": "allow",
      "curl.exe *": "allow",
      "type *": "allow",
      "dir *": "allow",
      "echo *": "allow"
    },
    "webfetch": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  }
}
