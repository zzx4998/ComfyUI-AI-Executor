{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "write": "deny",
    "patch": "deny",
    "bash": {
      "*": "deny",
      "curl *": "allow",
      "curl.exe *": "allow",
      "type *": "allow",
      "dir *": "allow",
      "echo *": "allow"
    },
    "webfetch": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  },
  "provider": {
    "aie-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "自定义 LLM (来自插件 LLM 设置)",
      "options": {
        "baseURL": "{env:AIE_LLM_BASE}",
        "apiKey": "{env:AIE_LLM_KEY}"
      },
      "models": {}
    }
  }
}
